{
  "manifest_version": 3,
  "name": "FireWally",
  "version": "1.3.7",
  "description": "FireWally companions via Gravity Tools relay — Admins side drawer (POC: localhost → GoCaaS; prod: PCP + JWT).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FireWally",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://admins.gsp-plat.int.gdcorp.tools/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://logic.azure.com/*",
    "https://*.logic.azure.com/*",
    "https://*.powerautomate.com/*",
    "https://*.powerplatform.com/*",
    "https://*.api.powerplatform.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://admins.gsp-plat.int.gdcorp.tools/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://admins.gsp-plat.int.gdcorp.tools/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://admins.gsp-plat.int.gdcorp.tools/*"]
    }
  ]
}
