# Local Gravity Tools relay — copy to ".env" and fill in real values.
# NEVER commit your real ".env" (it is gitignored).

PORT=8080

# GoDaddy S2S OAuth (client credentials) — POC only (local .env)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
GODADDY_OAUTH_URL=

# GoCaaS Open WebUI base URL (no trailing slash), e.g. https://gocaas.example/...
GOCAAS_BASE_URL=

# Optional — milliseconds before upstream chat times out (default 180000)
# GOCAAS_TIMEOUT_MS=180000

# --- Production placeholders (PCP + AWS Secrets Manager + JWT) ---
# AUTH_MODE=poc
# AUTH_MODE=jwt
# AWS_REGION=
# AWS_SECRETS_MANAGER_SECRET_ID=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_JWKS_URL=
